# Telegram bot token of the HAG alert route - EXAMPLE ONLY.
#
# Real file (never committed, mode 0600, server-local):
#   /home/jiri/.hag_telegram.env
#
# start_hag.sh sources this file (HAG_TELEGRAM_ENV_FILE) before it starts the
# service and refuses to start when HASS_TelegramBotToken is missing or empty,
# because the tracked production config enables the degraded-mode alert
# transport. The token belongs to the Hermes home-assistant profile's Telegram
# route; config/hvac_config_prod.yaml refers to it as
# "${HASS_TelegramBotToken}". The allowed chat id is non-secret and lives in
# the tracked config (hvacOptions.alerts.telegram.chatId).
#
# Create it on the deployment host (never in the repository):
#   (umask 077; printf '%s\n' \
#     'export HASS_TelegramBotToken="<bot-token>"' \
#     >> ~/.hag_telegram.env)
#   chmod 600 ~/.hag_telegram.env
#
# The shell syntax below is what the launcher expects: one `export NAME=value`
# line per variable, comments allowed.
export HASS_TelegramBotToken="REPLACE_WITH_TELEGRAM_BOT_TOKEN"
