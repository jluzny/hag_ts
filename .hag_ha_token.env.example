# Home Assistant token for the HAG production deployment - EXAMPLE ONLY.
#
# Real file (never committed, mode 0600, server-local):
#   /home/jiri/.hag_ha_token.env
#
# start_hag.sh sources this file (HAG_HA_TOKEN_ENV_FILE) before it starts the
# service and refuses to start when HASS_HassOptions__Token is missing or
# empty. The value is the Home Assistant long-lived access token that
# config/hvac_config_prod.yaml refers to as "${HASS_HassOptions__Token}".
#
# Create it on the deployment host (never in the repository):
#   (umask 077; printf '%s\n' \
#     'export HASS_HassOptions__Token="<long-lived-token>"' \
#     >> ~/.hag_ha_token.env)
#   chmod 600 ~/.hag_ha_token.env
#
# The shell syntax below is what the launcher expects: one `export NAME=value`
# line per variable, comments allowed.
export HASS_HassOptions__Token="REPLACE_WITH_HOME_ASSISTANT_LONG_LIVED_TOKEN"
